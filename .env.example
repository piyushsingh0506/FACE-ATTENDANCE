# ==========================================================
# NOTIFICATION CONFIGURATION (.env)
# ==========================================================

# Enable or disable notifications (True / False)
ENABLE_NOTIFICATIONS=True

# Notification Channel: "sms", "whatsapp", "fast2sms", or "simulation"
NOTIFICATION_CHANNEL=sms

# ----------------------------------------------------------
# OPTION 1: TWILIO (Global SMS & WhatsApp)
# Get credentials from: https://www.twilio.com/console
# ----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ----------------------------------------------------------
# OPTION 2: FAST2SMS (India SMS Gateway)
# Get free API key from: https://www.fast2sms.com/
# ----------------------------------------------------------
FAST2SMS_API_KEY=

# ----------------------------------------------------------
# OPTIONAL: ADMIN PHONE NUMBER
# Receives a copy alert whenever any person is recognized
# ----------------------------------------------------------
ADMIN_PHONE_NUMBER=
